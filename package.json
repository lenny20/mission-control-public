{
  "name": "mission-control",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/main.ts --dev",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "log": "node --disable-warning=ExperimentalWarning cli/log.ts",
    "typecheck": "tsc --noEmit",
    "service:install": "bash scripts/install-service.sh",
    "setup": "node scripts/setup.mjs",
    "doctor": "node --disable-warning=ExperimentalWarning cli/log.ts doctor"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.16",
    "marked": "^18.1.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yjs": "^13.6.29",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
